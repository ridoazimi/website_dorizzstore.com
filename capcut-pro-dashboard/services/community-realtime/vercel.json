{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "fluid": true,
  "rewrites": [
    {
      "source": "/socket.io/:path*",
      "destination": "/api/socket-io/socket.io/:path*"
    },
    {
      "source": "/health",
      "destination": "/api/health"
    }
  ],
  "functions": {
    "api/socket-io.mjs": {
      "maxDuration": 300
    },
    "api/health.mjs": {
      "maxDuration": 10
    }
  }
}
