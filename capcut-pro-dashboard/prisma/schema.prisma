generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                String                 @unique @db.VarChar(255)
  name                 String                 @db.VarChar(255)
  whatsapp             String?                @db.VarChar(50)
  customerType         String?                @default("new") @map("customer_type") @db.VarChar(50)
  notes                String?
  createdAt            DateTime?              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime?              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  subscriptionStatus   String?                @default("inactive") @map("subscription_status") @db.VarChar(50)
  followUpStatus       String?                @default("none") @map("follow_up_status") @db.VarChar(50)
  referredBy           String?                @map("referred_by") @db.Uuid
  affiliate            Affiliate?             @relation(fields: [referredBy], references: [id], onUpdate: NoAction)
  messageLogs          MessageLog[]
  transactions         Transaction[]
  affiliateCommissions AffiliateCommission[]
  pointLedger          AffiliatePointLedger[]
  tags                 CustomerTag[]

  @@map("users")
}

model StockAccount {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountEmail      String          @map("account_email") @db.VarChar(255)
  accountPassword   String          @map("account_password") @db.VarChar(255)
  status            String?         @default("available") @db.VarChar(50)
  durationDays      Int?            @default(30) @map("duration_days")
  notes             String?
  createdAt         DateTime?       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime?       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  productId         String?         @map("product_id") @db.Uuid
  product           Product?        @relation(fields: [productId], references: [id], onUpdate: NoAction)
  productType       String?         @default("mobile") @map("product_type") @db.VarChar(50)
  usageType         String?         @default("sale") @map("usage_type") @db.VarChar(50)
  maxSlots          Int?            @default(3) @map("max_slots")
  usedSlots         Int?            @default(0) @map("used_slots")
  transactions      Transaction[]
  newWarrantyClaims WarrantyClaim[] @relation("NewAccount")
  oldWarrantyClaims WarrantyClaim[] @relation("OldAccount")

  @@map("stock_accounts")
}

model Transaction {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lynkIdRef            String?                @unique @map("lynk_id_ref") @db.VarChar(255)
  userId               String?                @map("user_id") @db.Uuid
  stockAccountId       String?                @map("stock_account_id") @db.Uuid
  productId            String?                @map("product_id") @db.Uuid
  amount               Decimal                @default(0) @db.Decimal(12, 2)
  productName          String?                @map("product_name") @db.VarChar(255)
  status               String?                @default("success") @db.VarChar(50)
  source               String?                @default("lynkid") @db.VarChar(50)
  purchaseDate         DateTime?              @default(now()) @map("purchase_date") @db.Timestamptz(6)
  warrantyExpiredAt    DateTime?              @map("warranty_expired_at") @db.Timestamptz(6)
  receiptNumber        String?                @map("receipt_number")
  createdAt            DateTime?              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime?              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  paymentData          Json?                  @map("payment_data")
  messageLogs          MessageLog[]
  isManual             Boolean?               @default(false) @map("is_manual")
  voucherCode          String?                @map("voucher_code") @db.VarChar(50)
  stockAccount         StockAccount?          @relation(fields: [stockAccountId], references: [id], onUpdate: NoAction)
  product              Product?               @relation(fields: [productId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  user                 User?                  @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  warrantyClaims       WarrantyClaim[]
  affiliateCommissions AffiliateCommission[]
  pointLedger          AffiliatePointLedger[]
  salesId              String?                @map("sales_id") @db.Uuid
  sales                SalesTeam?             @relation(fields: [salesId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@map("transactions")
}

model WarrantyClaim {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transactionId String?       @map("transaction_id") @db.Uuid
  oldAccountId  String?       @map("old_account_id") @db.Uuid
  newAccountId  String?       @map("new_account_id") @db.Uuid
  claimReason   String?       @map("claim_reason")
  evidenceUrl   String?       @map("evidence_url")
  status        String?       @default("resolved") @db.VarChar(50)
  createdAt     DateTime?     @default(now()) @map("created_at") @db.Timestamptz(6)
  newAccount    StockAccount? @relation("NewAccount", fields: [newAccountId], references: [id], onUpdate: NoAction)
  oldAccount    StockAccount? @relation("OldAccount", fields: [oldAccountId], references: [id], onUpdate: NoAction)
  transaction   Transaction?  @relation(fields: [transactionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("warranty_claims")
}

model MessageLog {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String?      @map("user_id") @db.Uuid
  transactionId  String?      @map("transaction_id") @db.Uuid
  whatsappNumber String       @map("whatsapp_number") @db.VarChar(50)
  messageType    String       @map("message_type") @db.VarChar(50)
  messageContent String?      @map("message_content")
  status         String?      @default("sent") @db.VarChar(50)
  sentAt         DateTime?    @default(now()) @map("sent_at") @db.Timestamptz(6)
  transaction    Transaction? @relation(fields: [transactionId], references: [id], onUpdate: NoAction)
  user           User?        @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("message_logs")
}

// ===== Follow-Up Terjadwal =====

model ScheduledFollowup {
  id              String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title           String                       @db.VarChar(255)
  messageTemplate String                       @map("message_template")
  scheduledAt     DateTime                     @map("scheduled_at") @db.Timestamptz(6)
  status          String?                      @default("pending") @db.VarChar(50)
  totalRecipients Int?                         @default(0) @map("total_recipients")
  sentCount       Int?                         @default(0) @map("sent_count")
  createdAt       DateTime?                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime?                    @default(now()) @map("updated_at") @db.Timestamptz(6)
  recipients      ScheduledFollowupRecipient[]

  @@map("scheduled_followups")
}

model ScheduledFollowupRecipient {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  followupId     String?            @map("followup_id") @db.Uuid
  whatsappNumber String             @map("whatsapp_number") @db.VarChar(50)
  customerName   String?            @map("customer_name") @db.VarChar(255)
  status         String?            @default("pending") @db.VarChar(50)
  sentAt         DateTime?          @map("sent_at") @db.Timestamptz(6)
  followup       ScheduledFollowup? @relation(fields: [followupId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("scheduled_followup_recipients")
}

// ===== Affiliate System =====

model Affiliate {
  id             String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String                 @db.VarChar(255)
  whatsapp       String?                @db.VarChar(50)
  email          String?                @unique @db.VarChar(255)
  password       String?                @db.VarChar(255)
  inviteToken    String?                @unique @map("invite_token") @db.VarChar(255)
  commissionRate Decimal?               @default(10.00) @map("commission_rate") @db.Decimal(5, 2)
  totalEarned    Decimal?               @default(0) @map("total_earned") @db.Decimal(12, 2)
  balance        Decimal?               @default(0) @db.Decimal(12, 2)
  status         String?                @default("active") @db.VarChar(50)
  createdAt      DateTime?              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime?              @default(now()) @map("updated_at") @db.Timestamptz(6)
  referredUsers  User[]
  commissions    AffiliateCommission[]
  withdrawals    AffiliateWithdrawal[]
  pointLedger    AffiliatePointLedger[]

  @@map("affiliates")
}

model AffiliateCommission {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  affiliateId       String?      @map("affiliate_id") @db.Uuid
  transactionId     String?      @map("transaction_id") @db.Uuid
  userId            String?      @map("user_id") @db.Uuid
  amount            Decimal      @db.Decimal(12, 2)
  transactionAmount Decimal      @map("transaction_amount") @db.Decimal(12, 2)
  status            String?      @default("credited") @db.VarChar(50)
  createdAt         DateTime?    @default(now()) @map("created_at") @db.Timestamptz(6)
  affiliate         Affiliate?   @relation(fields: [affiliateId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  transaction       Transaction? @relation(fields: [transactionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user              User?        @relation(fields: [userId], references: [id], onUpdate: NoAction)

  @@map("affiliate_commissions")
}

model AffiliateWithdrawal {
  id              String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  affiliateId     String?                @map("affiliate_id") @db.Uuid
  amount          Decimal                @db.Decimal(12, 2)
  points          Int?                   @default(0)
  method          String?                @default("bank_transfer") @db.VarChar(30)
  accountNumber   String?                @map("account_number") @db.VarChar(100)
  accountName     String?                @map("account_name") @db.VarChar(255)
  payoutReference String?                @map("payout_reference") @db.VarChar(255)
  status          String?                @default("pending") @db.VarChar(50)
  notes           String?
  createdAt       DateTime?              @default(now()) @map("created_at") @db.Timestamptz(6)
  processedAt     DateTime?              @map("processed_at") @db.Timestamptz(6)
  affiliate       Affiliate?             @relation(fields: [affiliateId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  pointEntries    AffiliatePointLedger[]

  @@map("affiliate_withdrawals")
}

model AffiliatePointLedger {
  id            String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  affiliateId   String               @map("affiliate_id") @db.Uuid
  userId        String?              @map("user_id") @db.Uuid
  transactionId String?              @map("transaction_id") @db.Uuid
  withdrawalId  String?              @map("withdrawal_id") @db.Uuid
  points        Int
  type          String               @db.VarChar(40)
  status        String               @default("available") @db.VarChar(30)
  note          String?
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  affiliate     Affiliate            @relation(fields: [affiliateId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user          User?                @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  transaction   Transaction?         @relation(fields: [transactionId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  withdrawal    AffiliateWithdrawal? @relation(fields: [withdrawalId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([affiliateId, createdAt])
  @@map("affiliate_point_ledger")
}

// ===== Custom Tag System =====

model Tag {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String        @unique @db.VarChar(100)
  color     String        @default("#818cf8") @db.VarChar(20)
  createdAt DateTime?     @default(now()) @map("created_at") @db.Timestamptz(6)
  customers CustomerTag[]

  @@map("tags")
}

model CustomerTag {
  userId     String   @map("user_id") @db.Uuid
  tagId      String   @map("tag_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([userId, tagId])
  @@map("customer_tags")
}

// ===== App Settings (key-value store) =====

model AppSetting {
  key       String   @id @db.VarChar(100)
  value     String // JSON string atau plain string
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("app_settings")
}

// ===== Admin Users (Auth & RBAC) =====

model AdminUser {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email       String   @unique @db.VarChar(255)
  name        String   @db.VarChar(255)
  password    String   @db.VarChar(255)
  role        String   @default("admin") @map("role") @db.VarChar(50)
  status      String   @default("inactive") @db.VarChar(50)
  permissions Json?
  whatsapp    String?  @db.VarChar(20)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  schedule   AdminSchedule?
  tasks      TaskAssignment[]
  attendance AttendanceRecord[]

  @@map("admin_users")
}

// ===== Attendance: Jadwal Shift =====

model AdminSchedule {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminId    String    @unique @db.Uuid
  admin      AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  shiftStart String    @db.VarChar(5) // "08:00" WIB
  shiftEnd   String    @db.VarChar(5) // "17:00" WIB
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("admin_schedules")
}

// ===== Task Management (RKHI) =====

model Task {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title          String   @db.VarChar(255)
  description    String?  @db.Text
  recurrenceType String   @default("daily") @db.VarChar(20) // "daily" | "once"
  scheduledDate  String?  @db.VarChar(10) // "2026-04-09" — only for recurrenceType=once
  periodStart    String?  @map("period_start") @db.VarChar(10) // "2026-04-09" — optional period start
  periodEnd      String?  @map("period_end") @db.VarChar(10) // "2026-04-15" — optional period end
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  assignments TaskAssignment[]

  @@map("tasks")
}

model TaskAssignment {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId      String    @db.Uuid
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  adminId     String    @db.Uuid
  admin       AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  date        String    @db.VarChar(10) // "2026-04-09" — copy baru per hari via cron
  status      String    @default("pending") @db.VarChar(20) // pending | done
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  assignedAt  DateTime  @default(now()) @map("assigned_at") @db.Timestamptz(6)

  @@unique([taskId, adminId, date])
  @@map("task_assignments")
}

// ===== Attendance Records =====

model AttendanceRecord {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminId        String    @db.Uuid
  admin          AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  date           String    @db.VarChar(10) // "2026-04-09"
  checkInAt      DateTime? @map("check_in_at") @db.Timestamptz(6)
  checkOutAt     DateTime? @map("check_out_at") @db.Timestamptz(6)
  webhookSentIn  Boolean   @default(false) @map("webhook_sent_in")
  webhookSentOut Boolean   @default(false) @map("webhook_sent_out")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([adminId, date])
  @@map("attendance_records")
}

// ===== Marketplace =====

model Product {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String         @db.VarChar(255)
  slug               String?        @unique @db.VarChar(255)
  description        String?        @db.Text
  price              Decimal        @default(0) @db.Decimal(12, 2)
  discountPercentage Int?           @default(0) @map("discount_percentage")
  imageUrl           String?        @map("image_url") @db.VarChar(500)
  category           String?        @db.VarChar(100)
  maxSlots           Int?           @default(3) @map("max_slots")
  // productType String?  @default("mobile") @map("product_type") @db.VarChar(50)
  duration           Int?           @default(30)
  rules              String?        @db.Text
  messageTemplate    String?        @map("message_template") @db.Text
  isActive           Boolean        @default(true) @map("is_active")
  stockStatus        String         @default("INTEGRATED") @map("stock_status") @db.VarChar(50)
  sortOrder          Int            @default(0) @map("sort_order")
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  stockAccounts      StockAccount[]
  transactions       Transaction[]

  @@map("products")
}

model Voucher {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code         String    @unique @db.VarChar(50)
  type         String    @default("FIXED_AMOUNT") @db.VarChar(20) // "PERCENTAGE" or "FIXED_AMOUNT"
  value        Decimal   @default(0) @db.Decimal(12, 2)
  maxUsage     Int?      @map("max_usage")
  currentUsage Int?      @default(0) @map("current_usage")
  minPurchase  Decimal?  @default(0) @map("min_purchase") @db.Decimal(12, 2)
  expiryDate   DateTime? @map("expiry_date") @db.Timestamptz(6)
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("vouchers")
}

model DataNomor {
  id       Int     @id @default(autoincrement())
  nomor    String  @db.VarChar(50)
  statusAi String? @default("off") @map("status_ai") @db.VarChar(10)

  @@map("data_nomor")
}

model SalesTeam {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @db.VarChar(255)
  code      String   @unique @db.VarChar(100) // Kode unik sales (e.g. rido123)
  password  String?  @db.VarChar(255)
  whatsapp  String?  @db.VarChar(50)
  status    String   @default("active") @db.VarChar(50) // active | inactive
  category  String?  @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  transactions Transaction[]

  @@map("sales_teams")
}

model Testimonial {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type         String   @db.VarChar(20)
  mediaUrl     String   @map("media_url") @db.VarChar(500)
  customerName String   @map("customer_name") @db.VarChar(255)
  topTag       String?  @map("top_tag") @db.VarChar(100)
  statusText   String?  @map("status_text") @db.VarChar(255)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("testimonials")
}
